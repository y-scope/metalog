# Reproducible local test service. MinIO's former public images were removed.
FROM golang:1.25-bookworm AS build
RUN CGO_ENABLED=0 go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /go/bin/minio /usr/local/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
HEALTHCHECK --interval=1s --timeout=2s --retries=60 CMD curl -fsS http://localhost:9000/minio/health/live || exit 1
